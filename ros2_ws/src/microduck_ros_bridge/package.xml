<?xml version="1.0"?>
<package format="3">
  <name>microduck_ros_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge for the Microduck Unix socket protocol.</description>
  <maintainer email="maintainers@example.invalid">Microduck maintainers</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nlohmann_json</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
