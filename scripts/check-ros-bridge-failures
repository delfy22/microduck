#!/usr/bin/env python3
"""Exercise bridge safety and reconnect behaviour against fake Unix daemons.

Run in the sourced ROS development container after building the workspace. The
bridge runs in a private ROS domain and uses temporary sockets; no simulator or
real robot sockets are contacted.
"""

import argparse
import json
import math
import os
import select
import socket
import subprocess
import tempfile
import threading
import time

import rclpy
from diagnostic_msgs.msg import DiagnosticArray
from geometry_msgs.msg import TwistStamped
from nav_msgs.msg import Odometry
from rclpy.node import Node
from sensor_msgs.msg import PointCloud2


JOINT_NAMES = [f"joint_{index}" for index in range(12)]


def robot_model():
    return {
        "asset": "acceptance-fixture",
        "trunk_height_m": 0.1,
        "joint_names": JOINT_NAMES,
        "head_joints": [],
        "tof_beams": [[1.0, 0.0, 0.0] for _ in range(64)],
        "tof_fov_deg": 45.0,
        "frames_at_zero": {},
        "skeleton": [],
    }


def robot_state(with_timestamp=True):
    state = {
        "t": time.monotonic(),
        "move": {"requested": [0.0, 0.0, 0.0], "applied": [0.0, 0.0, 0.0]},
        "head": [0.0, 0.0, 0.0, 0.0],
        "policy": "walk",
        "safety": {"fallen": False, "limp": False, "gravity": [0.0, 0.0, -1.0]},
        "loop": {"hz": 50.0, "missed": 0},
        "joints": [0.0] * 12,
        "targets": [0.0] * 12,
        "velocities": [0.0] * 12,
        "imu": {"gyro": [0.0, 0.0, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]},
        "frames": {
            "tof": {"pos": [0.0, 0.0, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]},
            "camera": {"pos": [0.0, 0.0, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]},
        },
        "odom": {"position": [0.0, 0.0, 0.1], "yaw": 0.0},
    }
    if with_timestamp:
        state["t_ns"] = time.monotonic_ns()
    return state


class FakeDaemon:
    """Small NDJSON Unix server implementing robotd or tofd subscriptions."""

    def __init__(self, path, kind):
        self.path = path
        self.kind = kind
        self.lock = threading.Lock()
        self.clients = set()
        self.moves = []
        self.last_move = None
        self.last_move_at = 0.0
        self.accepted = 0
        self.stream_state = True
        self.state_has_timestamp = True
        self.drop_tof_connections = False
        self.stopping = False
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(path)
        self.server.listen()
        self.server.settimeout(0.2)
        self.thread = threading.Thread(target=self._accept, daemon=True)
        self.thread.start()

    def _accept(self):
        while not self.stopping:
            try:
                connection, _ = self.server.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with self.lock:
                self.clients.add(connection)
                self.accepted += 1
            threading.Thread(target=self._serve, args=(
                connection,), daemon=True).start()

    def _send(self, connection, value):
        connection.sendall(
            (json.dumps(value, separators=(",", ":")) + "\n").encode())

    def _serve(self, connection):
        connection.setblocking(False)
        subscribed = False
        buffer = b""
        next_frame = time.monotonic()
        try:
            while not self.stopping:
                ready, _, _ = select.select([connection], [], [], 0.02)
                if ready:
                    chunk = connection.recv(65536)
                    if not chunk:
                        break
                    buffer += chunk
                    while b"\n" in buffer:
                        line, buffer = buffer.split(b"\n", 1)
                        if not line:
                            continue
                        message = json.loads(line)
                        method = message.get("method")
                        if self.kind == "robot" and method == "robot.model":
                            self._send(connection, {"jsonrpc": "2.0", "id": message["id"],
                                                    "result": robot_model()})
                        elif self.kind == "robot" and method == "robot.subscribe":
                            self._send(connection, {"jsonrpc": "2.0", "id": message["id"],
                                                    "result": {"accepted": True}})
                            subscribed = True
                        elif method == "robot.move":
                            with self.lock:
                                params = message.get("params", {})
                                self.moves.append(params)
                                self.last_move = params
                                self.last_move_at = time.monotonic()
                        elif self.kind == "tof" and method == "tof.stream":
                            self._send(connection, {"jsonrpc": "2.0", "id": message["id"],
                                                    "result": {"accepted": True, "sensor": "fake",
                                                               "rows": 8, "cols": 8, "hz": 15}})
                            subscribed = True
                now = time.monotonic()
                if subscribed and now >= next_frame:
                    if self.kind == "robot":
                        if self.stream_state:
                            state = robot_state(self.state_has_timestamp)
                            state["move"] = self.current_move()
                            self._send(connection, {"jsonrpc": "2.0", "method": "robot.state",
                                                    "params": state})
                        next_frame = now + 0.05
                    else:
                        if self.drop_tof_connections:
                            break
                        frame = {"seq": int(now * 15), "at_us": int(now * 1e6),
                                 "t_ns": time.monotonic_ns(), "rows": 8, "cols": 8,
                                 "distance_mm": [1000] * 64, "status": [255] * 64}
                        self._send(
                            connection, {"jsonrpc": "2.0", "method": "tof.frame", "params": frame})
                        next_frame = now + 0.1
        except (OSError, ValueError, KeyError):
            pass
        finally:
            with self.lock:
                self.clients.discard(connection)
            try:
                connection.close()
            except OSError:
                pass

    def close_clients(self):
        with self.lock:
            clients = list(self.clients)
        for client in clients:
            try:
                client.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    def move_snapshot(self):
        with self.lock:
            return list(self.moves)

    def current_move(self):
        with self.lock:
            params = self.last_move or {}
            requested = [params.get("vx", 0.0), params.get(
                "vy", 0.0), params.get("vyaw", 0.0)]
            applied = requested if time.monotonic(
            ) - self.last_move_at <= 0.25 else [0.0, 0.0, 0.0]
            return {"requested": requested, "applied": applied}

    def close(self):
        self.stopping = True
        self.close_clients()
        self.server.close()
        self.thread.join(timeout=1.0)


class Probe(Node):
    def __init__(self):
        super().__init__("microduck_bridge_failure_probe")
        self.odom_count = 0
        self.empty_cloud_count = 0
        self.diagnostics = []
        self.publisher = self.create_publisher(TwistStamped, "/cmd_vel", 10)
        self.second_publisher = None
        self.create_subscription(Odometry, "/odom", self._odom, 10)
        self.create_subscription(PointCloud2, "/tof/points", self._cloud, 10)
        self.create_subscription(
            DiagnosticArray, "/diagnostics", self._diagnostics, 10)

    def _odom(self, _message):
        self.odom_count += 1

    def _cloud(self, message):
        if message.width == 0:
            self.empty_cloud_count += 1

    def _diagnostics(self, message):
        self.diagnostics = [status.message for status in message.status]

    def pump(self, seconds=0.1):
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=min(
                0.05, deadline - time.monotonic()))

    def command(self, vx, vy, yaw, stamp_offset=0.0, publisher=None):
        message = TwistStamped()
        stamp = self.get_clock().now().nanoseconds + int(stamp_offset * 1e9)
        message.header.stamp.sec = stamp // 1_000_000_000
        message.header.stamp.nanosec = stamp % 1_000_000_000
        message.header.frame_id = "base_link"
        message.twist.linear.x = vx
        message.twist.linear.y = vy
        message.twist.angular.z = yaw
        (publisher or self.publisher).publish(message)
        self.pump(0.1)


def require(condition, message):
    if not condition:
        raise AssertionError(message)


def wait_until(predicate, timeout, description, on_wait=None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return
        if on_wait:
            on_wait()
        else:
            time.sleep(0.02)
    raise AssertionError(f"timed out waiting for {description}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--bridge", default="ros2_ws/install/microduck_ros_bridge/lib/"
                        "microduck_ros_bridge/microduck_bridge",
                        help="built microduck_bridge executable")
    parser.add_argument("--timeout", type=float, default=20.0,
                        help="overall bounded run time in seconds (default: 20)")
    args = parser.parse_args()
    if args.timeout <= 0 or args.timeout > 60:
        raise SystemExit("--timeout must be between 0 and 60 seconds")

    with tempfile.TemporaryDirectory(prefix="microduck-bridge-test-") as directory:
        robot_path = os.path.join(directory, "robot.sock")
        tof_path = os.path.join(directory, "tof.sock")
        robot = FakeDaemon(robot_path, "robot")
        tof = FakeDaemon(tof_path, "tof")
        os.environ["ROS_DOMAIN_ID"] = "173"
        env = dict(os.environ)
        bridge = subprocess.Popen([
            args.bridge, "--ros-args",
            "-p", f"robot_socket:={robot_path}",
            "-p", f"tof_socket:={tof_path}",
        ], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        rclpy.init(args=[])
        probe = Probe()
        started = time.monotonic()
        try:
            def within_budget(predicate, seconds, message):
                require(time.monotonic() - started < args.timeout,
                        "overall test timeout exceeded")
                wait_until(predicate, min(seconds, args.timeout -
                           (time.monotonic() - started)), message,
                           on_wait=lambda: probe.pump(0.05))

            within_budget(lambda: probe.odom_count >= 3,
                          4.0, "robot state publications")
            within_budget(lambda: probe.publisher.get_subscription_count() >= 1,
                          5.0, "cmd_vel publisher discovery")
            within_budget(lambda: probe.empty_cloud_count >= 1,
                          4.0, "empty cloud for invalid ToF statuses")
            require(probe.empty_cloud_count > 0,
                    "invalid/no-target ToF statuses unexpectedly produced point returns")
            print("PASS: invalid ToF statuses produce no points")

            # A valid command is accepted and clamped to configured limits.
            before = len(robot.move_snapshot())
            probe.command(1.0, 0.0, 2.0)
            within_budget(lambda: len(robot.move_snapshot())
                          > before, 2.0, "clamped robot.move")
            move = robot.move_snapshot()[-1]
            require(math.isclose(move["vx"], 0.20, abs_tol=1e-6) and
                    math.isclose(move["vyaw"], 1.0,
                                 abs_tol=1e-6) and move["vy"] == 0.0,
                    f"command was not clamped / planar: {move}")
            print("PASS: fresh command accepted, clamped and lateral velocity zeroed")

            # Once the command expires, the bridge must cease replaying it.
            within_budget(lambda: any(
                all(abs(value) < 1e-6 for value in
                    (move.get("vx", 0.0), move.get("vy", 0.0), move.get("vyaw", 0.0)))
                for move in robot.move_snapshot()[before:]), 2.0, "one stop command after expiry")
            expired_count = len(robot.move_snapshot())
            time.sleep(0.35)
            require(len(robot.move_snapshot()) == expired_count,
                    "expired command continued reaching robotd")
            require(robot.current_move()["requested"] == [0.0, 0.0, 0.0] and
                    robot.current_move()["applied"] == [0.0, 0.0, 0.0],
                    "explicit expiry stop did not clear requested and applied motion")
            print(
                "PASS: one zero is sent on expiry and the daemon deadman clears applied motion")

            # Old and future-dated commands are rejected.
            for offset, label in ((-1.0, "stale"), (1.0, "future")):
                baseline = len(robot.move_snapshot())
                probe.command(0.1, 0.0, 0.1, stamp_offset=offset)
                time.sleep(0.35)
                require(not any(abs(move.get("vx", 0.0)) > 1e-6 or
                                abs(move.get("vyaw", 0.0)) > 1e-6
                                for move in robot.move_snapshot()[baseline:]),
                        f"{label} command reached robotd")
            print("PASS: stale and future-stamped commands rejected")

            # Multiple ROS publishers inhibit commands until ownership is unambiguous.
            probe.second_publisher = probe.create_publisher(
                TwistStamped, "/cmd_vel", 10)
            within_budget(lambda: probe.second_publisher.get_subscription_count() >= 1,
                          5.0, "second cmd_vel publisher discovery")
            baseline = len(robot.move_snapshot())
            probe.command(0.1, 0.0, 0.0)
            within_budget(lambda: any("multiple cmd_vel publishers" in text
                                      for text in probe.diagnostics),
                          3.0, "ambiguous publisher diagnostic")
            require(not any(abs(move.get("vx", 0.0)) > 1e-6 or
                            abs(move.get("vyaw", 0.0)) > 1e-6
                            for move in robot.move_snapshot()[baseline:]),
                    "command sent with ambiguous publishers")
            probe.destroy_publisher(probe.second_publisher)
            probe.second_publisher = None
            probe.command(0.1, 0.0, 0.0)
            within_budget(lambda: not any("multiple cmd_vel publishers" in text
                                          for text in probe.diagnostics),
                          3.0, "single publisher ownership recovery")
            print("PASS: ambiguous command publishers inhibit movement")

            # State freshness gates command forwarding.
            baseline = len(robot.move_snapshot())
            probe.command(0.1, 0.0, 0.0)
            within_budget(lambda: len(robot.move_snapshot()) >
                          baseline, 1.0, "fresh move before state loss")
            robot.stream_state = False
            time.sleep(0.35)
            within_budget(lambda: any(
                all(abs(value) < 1e-6 for value in
                    (move.get("vx", 0.0), move.get("vy", 0.0), move.get("vyaw", 0.0)))
                for move in robot.move_snapshot()[baseline:]), 1.0, "one stop command after state loss")
            stop_index = len(robot.move_snapshot())
            stale_deadline = time.monotonic() + 0.45
            while time.monotonic() < stale_deadline:
                probe.command(0.1, 0.0, 0.0)
            require(not any(abs(move.get("vx", 0.0)) > 1e-6 or abs(move.get("vyaw", 0.0)) > 1e-6
                            for move in robot.move_snapshot()[stop_index:]),
                    "fresh commands kept reaching robotd after robot.state became stale")
            require(robot.current_move()["requested"] == [0.0, 0.0, 0.0],
                    "stale robot.state did not clear the daemon's requested move")
            robot.stream_state = True
            print("PASS: stale robot state stops command forwarding")

            # Dropping the daemon connection must reconnect without replaying the last intent.
            prior_connections = robot.accepted
            robot.close_clients()
            within_budget(lambda: robot.accepted >
                          prior_connections, 3.0, "robot socket reconnect")
            reconnect_moves = len(robot.move_snapshot())
            time.sleep(0.35)
            require(not any(abs(move.get("vx", 0.0)) > 1e-6 or
                            abs(move.get("vyaw", 0.0)) > 1e-6
                            for move in robot.move_snapshot()[reconnect_moves:]),
                    "old command replayed after robot socket reconnect")
            print("PASS: robot socket EOF reconnects without stale command replay")

            # A daemon frame without a shared monotonic timestamp is not published as state.
            probe.pump(0.15)
            before_odom = probe.odom_count
            robot.state_has_timestamp = False
            probe.pump(0.35)
            after_odom = probe.odom_count
            robot.state_has_timestamp = True
            require(after_odom == before_odom,
                    "robot state without t_ns was published with a fabricated timestamp")
            print("PASS: state lacking monotonic timestamp is dropped")
            print("PASS: bridge failure acceptance checks complete")
        finally:
            probe.destroy_node()
            rclpy.shutdown()
            bridge.terminate()
            try:
                bridge.wait(timeout=2.0)
            except subprocess.TimeoutExpired:
                bridge.kill()
                bridge.wait(timeout=1.0)
            robot.close()
            tof.close()
            if bridge.returncode not in (0, -15):
                error = bridge.stderr.read() if bridge.stderr else ""
                raise RuntimeError(
                    f"bridge exited with {bridge.returncode}: {error[-2000:]}")


if __name__ == "__main__":
    main()
